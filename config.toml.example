# Copy to config.toml and run from the repository root:
#   cargo run -- --config config.toml
# Explicit CLI options override the corresponding settings here.
# Relative paths are resolved from the working directory.

# Runtime data tables generated by hd-dumper (see README).
resources_dir = "resources"

# Console detail: off, error, warn, info, debug or trace.
log_level = "info"

# HTTP bootstrap listener. Use 0.0.0.0:8080 to accept connections from a device.
http_listen = "127.0.0.1:8080"

# Encrypted game connection listener. Use 0.0.0.0:9339 for a device.
game_listen = "127.0.0.1:9339"

# Game server address advertised to the client by bootstrap. The native client
# refuses private IPv4 ranges, so use a public or benchmarking-range address
# (198.18.0.0/15) that the device can reach. Assigning it to a host interface
# is up to you.
game_host = "198.18.0.1"

# Asset base URL advertised to the client. Keep the trailing slash.
# hd-server does not serve assets.
asset_url = "http://game-assets.haydaygame.com/"

# Delay in milliseconds between PostLoginReady (10366) and the home (26017).
after_ready_delay_ms = 7000

# Idle timeout for a game connection, in seconds.
idle_secs = 900

# Account storage backend. "file" uses the JSON account index (data/accounts.json by default).
# Override with --storage-backend.
storage_backend = "file"

# Starting HUD balances for NEW accounts only. Omit to use the built-in values.
# cash and diamonds set the total balances (starter FreeCash/FreeDiamonds are merged in).
# cash = 350
# diamonds = 30

# Opt existing homes into supported command replay. New starter homes already
# replay automatically. Existing farms are not reset or migrated.
# replay_commands = true

# Greg's AI farm for visit mode is read from <resources_dir>/home-greg.json.
# A missing file disables Greg visits.

# Development controls in the friends bar: reset the account, add gold and
# diamonds, skip the tutorial, or finish every running timer. For local
# testing only. Off by default.
dev_friends = false
